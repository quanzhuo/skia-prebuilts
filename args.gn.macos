# Set build arguments here. See `gn help buildargs`.

# 预编译包面向下游 CMake 项目，而不是 Skia 自身开发。
# official + component build 生成优化后的 libskia.dylib。
is_official_build = true
is_component_build = true

# 不启用 Skia 的 trivial ABI 优化，避免 C++ dylib 边界更依赖特定编译器 ABI 细节。
is_trivial_abi = false

# 由 generate_skia_package.py 追加 target_cpu 和 min_macos_version。
target_os = "mac"

# 不构建 viewer、bench、tests 等工具；预编译包只发布 runtime library。
skia_enable_tools = false

# FluidUI 当前使用 Skia Ganesh GPU API。
# macOS GPU 后端选择 Metal；OpenGL 在 macOS 上已长期 deprecated，因此显式关闭 GL。
skia_enable_ganesh = true
skia_use_gl = false
skia_use_metal = true
skia_use_vulkan = false
skia_use_dawn = false
skia_use_webgl = false

# FluidUI 自己管理文本 shaping / Unicode 依赖，Skia 包只承担绘制和图片解码。
skia_use_harfbuzz = false
skia_use_icu = false

# macOS 使用 CoreText 字体栈，不需要 fontconfig/freetype。
skia_use_fontconfig = false
skia_use_freetype = false

# FluidUI 公共位图基线保证 PNG 编解码和 JPEG 解码。JPEG 编码和 WebP
# 尚未进入公共契约，不让预编译包为未使用能力付出代码体积。
skia_use_libpng_decode = true
skia_use_libpng_encode = true
skia_use_libjpeg_turbo_decode = true
skia_use_libjpeg_turbo_encode = false
skia_use_libwebp_decode = false
skia_use_libwebp_encode = false

# 使用 Skia third_party 里的 codec/zlib，避免下游应用复现一组系统依赖版本。
skia_use_system_expat = false
skia_use_system_libpng = false
skia_use_system_libjpeg_turbo = false
skia_use_system_libwebp = false
skia_use_system_zlib = false

# 关闭当前 UI runtime 不需要的文档/动画/SVG/RAW 等模块。
skia_enable_pdf = false
skia_enable_skottie = false
skia_enable_svg = false
skia_use_expat = false
skia_use_dng_sdk = false
skia_use_piex = false

# 不引入 Chromium PartitionAlloc，降低预编译包和宿主进程的 allocator 耦合。
skia_use_partition_alloc = false

# 让 macOS component build 使用 libc++，并保留当前包所需的兼容性宏。
extra_cflags = [
  "-DSK_AVOID_SLOW_RASTER_PIPELINE_BLURS",
  "-DHAVE_ARC4RANDOM_BUF",
  "-stdlib=libc++",
]
extra_ldflags = [ "-stdlib=libc++" ]
