if(NOT (@SKIA_CMAKE_PLATFORM_CONDITION@))
    set(Skia_FOUND FALSE)
    set(Skia_NOT_FOUND_MESSAGE "This Skia prebuilt package targets @SKIA_PREBUILT_PLATFORM@, but the current CMake platform is ${CMAKE_SYSTEM_NAME}.")
    return()
endif()

# These Windows binaries use the MSVC C++ ABI. MinGW is a different ABI.
if(WIN32 AND CMAKE_CXX_COMPILER_ID AND NOT MSVC)
    set(Skia_FOUND FALSE)
    set(Skia_NOT_FOUND_MESSAGE "This Windows package requires an MSVC ABI compiler (MSVC or clang-cl).")
    return()
endif()

# Reject incompatible binaries before importing any targets. Target settings
# take precedence over the build host's architecture.
set(_skia_requested_arch "${CMAKE_SYSTEM_PROCESSOR}")
if(APPLE AND CMAKE_OSX_ARCHITECTURES)
    list(LENGTH CMAKE_OSX_ARCHITECTURES _skia_arch_count)
    if(NOT _skia_arch_count EQUAL 1)
        set(Skia_FOUND FALSE)
        set(Skia_NOT_FOUND_MESSAGE "This is a thin @SKIA_TARGET_CPU@ package; select exactly one macOS architecture.")
        return()
    endif()
    set(_skia_requested_arch "${CMAKE_OSX_ARCHITECTURES}")
elseif(WIN32 AND CMAKE_GENERATOR_PLATFORM)
    string(REGEX REPLACE ",.*$" "" _skia_requested_arch "${CMAKE_GENERATOR_PLATFORM}")
elseif(WIN32 AND CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
    set(_skia_requested_arch "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
elseif(WIN32 AND MSVC_CXX_ARCHITECTURE_ID)
    set(_skia_requested_arch "${MSVC_CXX_ARCHITECTURE_ID}")
endif()
string(TOLOWER "${_skia_requested_arch}" _skia_requested_arch)
if(_skia_requested_arch MATCHES "^(amd64|x86_64|x64)$")
    set(_skia_requested_arch x64)
elseif(_skia_requested_arch MATCHES "^(aarch64|arm64)$")
    set(_skia_requested_arch arm64)
endif()
if(NOT _skia_requested_arch STREQUAL "@SKIA_TARGET_CPU@"
    OR (DEFINED CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8))
    set(Skia_FOUND FALSE)
    set(Skia_NOT_FOUND_MESSAGE "Skia package targets @SKIA_PREBUILT_PLATFORM@; consumer architecture is ${_skia_requested_arch}.")
    return()
endif()
unset(_skia_requested_arch)
unset(_skia_arch_count)

if(NOT COMMAND check_required_components)
    macro(check_required_components _package_name)
        foreach(_component ${${_package_name}_FIND_COMPONENTS})
            if(NOT ${_package_name}_${_component}_FOUND)
                if(${_package_name}_FIND_REQUIRED_${_component})
                    set(${_package_name}_FOUND FALSE)
                endif()
            endif()
        endforeach()
    endmacro()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/SkiaTargets.cmake")

set(Skia_VERSION "@SKIA_PACKAGE_VERSION@")
set(Skia_MILESTONE "@SKIA_MILESTONE@")
set(Skia_COMMIT "@SKIA_COMMIT@")
set(Skia_RELEASE_TAG "@SKIA_RELEASE_TAG@")
set(Skia_RELEASE_REVISION "@SKIA_RELEASE_REVISION@")
set(Skia_PREBUILT_PLATFORM "@SKIA_PREBUILT_PLATFORM@")
set(Skia_GPU_BACKENDS "@SKIA_GPU_BACKENDS@")
set(Skia_BUILD_PROFILE "@SKIA_BUILD_PROFILE@")
set(Skia_HAS_PATHOPS TRUE)
set(Skia_SANITIZER "none")
set(Skia_HEADER_ABI "uninstrumented")

if(NOT TARGET Skia::Skia)
    set(Skia_FOUND FALSE)
    set(Skia_NOT_FOUND_MESSAGE "SkiaTargets.cmake did not define Skia::Skia.")
    return()
endif()

check_required_components(Skia)
