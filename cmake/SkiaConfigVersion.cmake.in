set(PACKAGE_VERSION "@SKIA_PACKAGE_VERSION@")
set(PACKAGE_VERSION_COMPATIBLE FALSE)
set(PACKAGE_VERSION_EXACT FALSE)

if(PACKAGE_FIND_VERSION_RANGE)
    # SameMajorVersion: check both bounds and restrict the entire requested
    # range to this major, allowing the exclusive next-major boundary.
    math(EXPR _skia_next_major "@SKIA_PACKAGE_VERSION_MAJOR@ + 1")
    if(PACKAGE_FIND_VERSION_MIN_MAJOR STREQUAL "@SKIA_PACKAGE_VERSION_MAJOR@"
        AND NOT PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION_MIN)
        if(PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "INCLUDE"
            AND PACKAGE_FIND_VERSION_MAX_MAJOR STREQUAL "@SKIA_PACKAGE_VERSION_MAJOR@"
            AND PACKAGE_VERSION VERSION_LESS_EQUAL PACKAGE_FIND_VERSION_MAX)
            set(PACKAGE_VERSION_COMPATIBLE TRUE)
        elseif(PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "EXCLUDE"
            AND PACKAGE_FIND_VERSION_MAX VERSION_LESS_EQUAL _skia_next_major
            AND PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION_MAX)
            set(PACKAGE_VERSION_COMPATIBLE TRUE)
        endif()
    endif()
    unset(_skia_next_major)
elseif(PACKAGE_FIND_VERSION)
    if(PACKAGE_FIND_VERSION_MAJOR STREQUAL "@SKIA_PACKAGE_VERSION_MAJOR@"
        AND PACKAGE_FIND_VERSION VERSION_LESS_EQUAL PACKAGE_VERSION)
        set(PACKAGE_VERSION_COMPATIBLE TRUE)
    endif()

    if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
        set(PACKAGE_VERSION_EXACT TRUE)
    endif()
else()
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
endif()
