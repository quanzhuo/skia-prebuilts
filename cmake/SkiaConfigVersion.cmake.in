set(PACKAGE_VERSION "@SKIA_PACKAGE_VERSION@")

if(PACKAGE_FIND_VERSION_RANGE)
    # This prebuilt package follows the simple single-version compatibility
    # model generated by write_basic_package_version_file(... SameMajorVersion).
    if(PACKAGE_FIND_VERSION_MIN_MAJOR STREQUAL "@SKIA_PACKAGE_VERSION_MAJOR@")
        set(PACKAGE_VERSION_COMPATIBLE TRUE)
    else()
        set(PACKAGE_VERSION_COMPATIBLE FALSE)
    endif()
elseif(PACKAGE_FIND_VERSION)
    if(PACKAGE_FIND_VERSION_MAJOR STREQUAL "@SKIA_PACKAGE_VERSION_MAJOR@"
        AND PACKAGE_FIND_VERSION VERSION_LESS_EQUAL PACKAGE_VERSION)
        set(PACKAGE_VERSION_COMPATIBLE TRUE)
    else()
        set(PACKAGE_VERSION_COMPATIBLE FALSE)
    endif()

    if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
        set(PACKAGE_VERSION_EXACT TRUE)
    endif()
else()
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
endif()
